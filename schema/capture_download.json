{"$id":"https://suite-contract.local/schema/capture_download.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"downloadKey":{"pattern":"^[0-9a-f]{64}$","type":"string"},"downloadedAt":{"minimum":0,"type":"integer"},"entities":{"items":{"type":"string"},"type":"array"},"filename":{"type":"string"},"foTagIds":{"items":{"type":"string"},"type":"array"},"localTags":{"type":"array","items":{"type":"array","items":{"type":"string","minLength":1},"minItems":1}},"scrapedFields":{"type":"object"},"sensitive":{"enum":["finance","health","job","personal"]},"sourceKey":{"pattern":"^[^:]+:[^:]+:[^:]+$","type":"string"},"sourceTitle":{"type":"string"},"sourceUrl":{"type":"string"},"type":{"const":"capture_download"},"urlHash":{"pattern":"^[0-9a-f]{64}$","type":"string","description":"Hash of the browser DownloadItem.finalUrl, which may be a blob: URL. Receivers MUST NOT use it for provenance indexing; use sourceUrl and sourceKey instead."},"path":{"type":"string","minLength":1,"description":"Absolute local path of the file, filled only when the sender initiated the download itself. Receiver uses it for file-ready check and capture-folder handling; falls back to legacy lookup when absent."}},"required":["type","downloadKey","urlHash","filename"],"type":"object"}